# Copy to .env.local for local testing. On Vercel, set these under Project -> Settings -> Environment Variables.

# Scanner worker (leave empty to run with the sample website only)
SCANNER_URL=
SCANNER_TOKEN=

# Where leads go: a webhook from Google Apps Script, Zapier, Make, HubSpot, etc.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Bump when you change Kensara's privacy notice, so each lead records which version they saw
LEAD_NOTICE_VERSION=2026-09

# Cloudflare Turnstile secret (pair with turnstileSiteKey in public/site-config.js)
TURNSTILE_SECRET=
